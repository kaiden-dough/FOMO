# Copy to .env and adjust as needed
# For Postgres later, set something like:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fomo
DATABASE_URL=sqlite:///./fomo.db

# Start blue with password; test green with hybrid; use google after validation.
# Existing direct Google clients keep working on blue/hybrid with this ID.
GOOGLE_CLIENT_ID=
AUTH_MODE=password
DEPLOYMENT_COLOR=local
SUPABASE_URL=
# Public/publishable key only. Never use a service_role or secret key in the frontend.
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of allowed frontend origins for browser CORS.
# Add your Vercel URL here in production.
# Example:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
