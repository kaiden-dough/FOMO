# Copy to .env and adjust as needed
# For Postgres later, set something like:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fomo
DATABASE_URL=sqlite:///./fomo.db

# Optional but recommended: OAuth web client ID used for backend audience validation.
# Example: 1234567890-abcxyz.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins for browser CORS.
# Add your Vercel URL here in production.
# Example:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
