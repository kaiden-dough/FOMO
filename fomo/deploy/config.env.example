# Copy to .env in this folder. Keep actual credentials out of Git.
# Use Supabase's session pooler URL (port 5432) with the psycopg driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Preserve the existing Google client ID on blue/hybrid for old clients.
GOOGLE_CLIENT_ID=
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=http://localhost:3000,https://YOUR-FRONTEND.vercel.app
BLUE_AUTH_MODE=password
GREEN_AUTH_MODE=hybrid
# Use immutable release tags when deploying; retain blue for rollback.
BLUE_IMAGE=fomo-api:blue
GREEN_IMAGE=fomo-api:green
